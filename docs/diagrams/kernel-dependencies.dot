// Render: dot -Tsvg docs/diagrams/kernel-dependencies.dot -o docs/diagrams/kernel-dependencies.svg
// PNG: dot -Tpng -Gdpi=120 docs/diagrams/kernel-dependencies.dot -o docs/diagrams/kernel-dependencies.png
// Derived from arm-none-eabi-nm object symbols; see docs/architecture.md for profiles and scope.
digraph RK0Dependencies {
  graph [rankdir=LR, bgcolor="white", pad="0.45", nodesep="0.24", ranksep="1.0",
    fontname="Helvetica", fontsize=12, compound=true, splines=spline, labelloc=t, labeljust=l,
    label=<<FONT POINT-SIZE="26" COLOR="#162d46"><B>RK0 / File dependencies</B></FONT><BR ALIGN="LEFT"/>
      <FONT POINT-SIZE="12" COLOR="#52657b">A &#8594; B: A has an undefined symbol supplied by B. Hover an arrow to inspect its symbols.</FONT><BR ALIGN="LEFT"/>
      <FONT POINT-SIZE="11" COLOR="#52657b">Solid: default features with debug checks. Dashed: added by dynamic tasks, dynamic objects, or tracing.</FONT><BR ALIGN="LEFT"/>
      <FONT POINT-SIZE="11" COLOR="#52657b">Core pairs: core/src/name.c + core/inc/name.h. Headers are associations; edges describe compiled objects.</FONT><BR ALIGN="LEFT"/>>];
  node [shape=box, style="rounded,filled", fillcolor="#eef4fd", color="#aec4e0",
    fontcolor="#162d46", fontname="Helvetica", fontsize=11, margin="0.16,0.10"];
  edge [color="#6c8199", arrowsize=0.6, penwidth=1.1, fontname="Helvetica", fontsize=9];
  subgraph cluster_0 {
    label="Message passing";
    color="#dce4ec"; style="rounded"; fontcolor="#435970"; margin=14;
    kexchg [label="Pointer exchange\nkexchg.c + kexchg.h", URL="../../core/src/kexchg.c", tooltip="core/src/kexchg.c"];
    kmesgq [label="Copied queues / mailboxes\nkmesgq.c + kmesgq.h", URL="../../core/src/kmesgq.c", tooltip="core/src/kmesgq.c"];
    kmesg [label="Owned asynchronous messages\nkmesg.c + kmesg.h", URL="../../core/src/kmesg.c", tooltip="core/src/kmesg.c"];
    kchannel [label="Synchronous channels\nkchannel.c + kchannel.h", URL="../../core/src/kchannel.c", tooltip="core/src/kchannel.c"];
    kmrm [label="Most-recent messages\nkmrm.c + kmrm.h", URL="../../core/src/kmrm.c", tooltip="core/src/kmrm.c"];
  }
  subgraph cluster_1 {
    label="Synchronisation";
    color="#dce4ec"; style="rounded"; fontcolor="#435970"; margin=14;
    ksema [label="Semaphores\nksema.c + ksema.h", URL="../../core/src/ksema.c", tooltip="core/src/ksema.c"];
    kmutex [label="Mutex protocols\nkmutex.c + kmutex.h", URL="../../core/src/kmutex.c", tooltip="core/src/kmutex.c"];
    kbarrier [label="Reusable barriers\nkbarrier.c + kbarrier.h", URL="../../core/src/kbarrier.c", tooltip="core/src/kbarrier.c"];
    ksleepq [label="Sleep queues / condition variables\nksleepq.c + ksleepq.h", URL="../../core/src/ksleepq.c", tooltip="core/src/ksleepq.c"];
  }
  subgraph cluster_2 {
    label="Memory and dynamic objects";
    color="#dce4ec"; style="rounded"; fontcolor="#435970"; margin=14;
    kmem [label="Fixed-block partitions\nkmem.c + kmem.h", URL="../../core/src/kmem.c", tooltip="core/src/kmem.c"];
    kdynobjs [label="Dynamic object lifecycle\nkdynobjs.c + kdynobjs.h", URL="../../core/src/kdynobjs.c", tooltip="core/src/kdynobjs.c", style="rounded,filled,dashed", fillcolor="#fff4df", color="#bd9454"];
  }
  subgraph cluster_3 {
    label="Tasks and scheduling";
    color="#dce4ec"; style="rounded"; fontcolor="#435970"; margin=14;
    ktasksuspend [label="Suspend / resume\nktasksuspend.c + ktasksuspend.h", URL="../../core/src/ktasksuspend.c", tooltip="core/src/ktasksuspend.c"];
    ktaskevents [label="Private task events\nktaskevents.c + ktaskevents.h", URL="../../core/src/ktaskevents.c", tooltip="core/src/ktaskevents.c"];
    ksch [label="High-level scheduler / task pool / tick dispatch\nksch.c + ksch.h", URL="../../core/src/ksch.c", tooltip="core/src/ksch.c"];
  }
  subgraph cluster_4 {
    label="Time and system tasks";
    color="#dce4ec"; style="rounded"; fontcolor="#435970"; margin=14;
    ktimer [label="Sleep / timeout / callout timers\nktimer.c + ktimer.h", URL="../../core/src/ktimer.c", tooltip="core/src/ktimer.c"];
    ksystasks [label="Idle / deferred jobs / callbacks\nksystasks.c + ksystasks.h", URL="../../core/src/ksystasks.c", tooltip="core/src/ksystasks.c"];
  }
  subgraph cluster_5 {
    label="Data structures";
    color="#dce4ec"; style="rounded"; fontcolor="#435970"; margin=14;
    klist [label="Linked lists\nklist.c + klist.h", URL="../../core/src/klist.c", tooltip="core/src/klist.c"];
    kringbuf [label="Ring buffers\nkringbuf.c + kringbuf.h", URL="../../core/src/kringbuf.c", tooltip="core/src/kringbuf.c"];
  }
  subgraph cluster_6 {
    label="Diagnostics and identity";
    color="#dce4ec"; style="rounded"; fontcolor="#435970"; margin=14;
    ktrace [label="Trace task / records / console\nktrace.c + ktrace.h", URL="../../core/src/ktrace.c", tooltip="core/src/ktrace.c", style="rounded,filled,dashed", fillcolor="#fff4df", color="#bd9454"];
    kerr [label="Fault capture / panic\nkerr.c + kerr.h", URL="../../core/src/kerr.c", tooltip="core/src/kerr.c"];
    kversion [label="Version validation\nkversion.c + kversion.h", URL="../../core/src/kversion.c", tooltip="core/src/kversion.c"];
  }
  subgraph cluster_7 {
    label="C runtime hooks";
    color="#dce4ec"; style="rounded"; fontcolor="#435970"; margin=14;
    syscalls [label="newlib hooks / libc heap\ncore/src/syscalls.c", URL="../../core/src/syscalls.c", tooltip="core/src/syscalls.c"];
  }
  subgraph cluster_8 {
