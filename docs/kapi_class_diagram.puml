@startuml kapi_class_diagram
' Structural view of kapi.h and the control blocks it exposes.
title RK0 kapi.h - Kernel component architecture

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam class {
    BackgroundColor #F7F9FC
    BorderColor #344054
    ArrowColor #475467
    FontColor #101828
    AttributeIconSize 0
}
skinparam package {
    BorderColor #98A2B3
    BackgroundColor #FCFCFD
}

legend right
    <&folder> package = logical subsystem
    <&database> composition = embedded storage
    --> association = pointer/reference
    ..> dependency = API or shared mechanism
endlegend

package "Public API: kapi.h" {
    class RK0_API <<facade>> {
        +kInit()
        +kYield()
        +kTask*()
        +kEvent*()
        +kSemaphore*()
        +kMutex*()
        +kSleepQueue*()
        +kMesgQueue*()
        +kMemPartition*()
        +kTimer*()
        +kSynchMesg*()
        +kMRM*()
        +kTrace*()
    }

    class RK0_Executive <<aggregation>> {
        +kSchLock() / kSchUnlock()
        +scheduler and context switching
        +post-processing system task
    }
}

package "Kernel objects: kobjs.h" {
    class RK_OBJ_TCB {
        sp / stackBufPtr / stackSize
        tid / taskName
        status / priority / prioNominal
        preempt / schLock / init
        flagsCurr / flagsReq / flagsOpt
        wakeTime / timeOut / overrunCount
        timeoutNode : RK_TIMEOUT_NODE
        tcbNode : RK_NODE
        ownedMutexList : RK_LIST
        +task entry and wait state
    }

    class RK_OBJ_MEM_PARTITION {
        objID / objName / init
        freeListPtr / poolPtr
        blkSize / nMaxBlocks / nFreeBlocks
        waitingQueue : RK_LIST
        +alloc() / free()
    }

    class RK_OBJ_TIMER {
        objID / objName / init
        reload / phase / period / nextTime
        funPtr / argsPtr
        timeoutNode : RK_TIMEOUT_NODE
        +cancel() / reload()
    }

    class RK_OBJ_SEMAPHORE {
        objID / objName / init
        value / maxValue
        waitingQueue : RK_LIST
        +pend() / post()
    }

    class RK_OBJ_MUTEX {
        objID / objName / init
        lock / protocol
        ownerPtr : RK_OBJ_TCB
        waitingQueue : RK_LIST
        mutexNode : RK_NODE
        +lock() / unlock()
    }

    class RK_OBJ_SLEEP_QUEUE {
        objID / objName / init
        waitingQueue : RK_LIST
        +sleep() / wake() / ready()
    }

    class RK_OBJ_MESG_QUEUE {
        objID / objName / init
        waitingReceivers : RK_LIST
        waitingSenders : RK_LIST
        ringBuf : RK_STRUCT_RING_BUFFER
        broadcastReceivers
        sendNotifyCbk()
        +send() / receive() / reset()
    }

    class RK_OBJ_MESG {
        mesgNode / ownerNode : RK_NODE
        poolPtr : RK_MEM_PARTITION
        sender / receiver / owner : RK_TASK_HANDLE
        payloadBytes / state
    }

    class RK_OBJ_MRM {
        objID / objName / init
        mrmMem : RK_OBJ_MEM_PARTITION
        mrmDataMem : RK_OBJ_MEM_PARTITION
        currBufPtr : RK_OBJ_MRM_BUF
        size
        +reserve() / publish() / get() / unget()
    }

    class RK_OBJ_MRM_BUF {
        objID / objName
        mrmData
        nUsers
    }
}

package "Shared kernel primitives" {
    class RK_STRUCT_LIST {
        listDummy : RK_NODE
        size
    }

    class RK_STRUCT_LIST_NODE {
        nextPtr
        prevPtr
    }

    class RK_STRUCT_TIMEOUT_NODE {
        nextPtr / prevPtr
        listRefPtr
        timeoutType / timeout / dtick
        waitingQueuePtr : RK_LIST
        waitInfo
    }

    class RK_STRUCT_RING_BUFFER {
        dataSize / maxBuf / nFull
        bufPtr / writePtr / readPtr / bufEndPtr
    }

    class RK_STRUCT_RUNTIME {
        globalTick
        nWraps
    }
}

package "Task communication" {
    class RK_STRUCT_SYNCH_ATTR <<value>> {
        reqPtr / reqBytes
        replyPtr / replyMaxBytes
        replyBytesPtr
    }

    class RK_STRUCT_SYNCH_CALL_DATA <<value>> {
        caller : RK_TASK_HANDLE
        reqPtr / reqBytes
        replyPtr / replyMaxBytes
    }

    class Task_Event_Register <<embedded in TCB>> {
        flagsCurr
        flagsReq
        flagsOpt
    }
}

package "Trace and inspection" {
    class RK_TRACE_TASK_INFO <<snapshot>> {
        taskHandle / tid / name
        status / priority / runCnt
        eventCurr / eventReq
        cpuTicks / cpuPct
        stack usage / overrunCount
    }

    class RK_TRACE_OBJECT_INFO <<snapshot>> {
        objID / objName / objPtr
        ownerPtr / buffered / capacity
        waitingSenders / waitingReceivers
    }

    class RK_TRACE_SYNC_INFO <<snapshot>> {
        objID / objName / objPtr
        ownerPtr / locked / value
        maxValue / protocol / waitingTasks
    }

    class RK_TRACE_TIMER_INFO <<snapshot>> {
        objID / objName / objPtr
        active / reload / phase / period
        remainingTicks / argsPtr
    }
}

' kapi.h includes kexecutive.h, which aggregates the subsystem headers.
RK0_API ..> RK0_Executive : public entry points
RK0_Executive ..> RK_OBJ_TCB : scheduler manages
RK0_Executive ..> RK_STRUCT_RUNTIME : tick source

' Intrusive lists are the common waiting and ownership mechanism.
RK_STRUCT_LIST *-- RK_STRUCT_LIST_NODE : contains sentinel / nodes
RK_OBJ_TCB *-- RK_STRUCT_TIMEOUT_NODE : embeds
RK_OBJ_TCB *-- RK_STRUCT_LIST_NODE : embeds tcbNode
RK_OBJ_TIMER *-- RK_STRUCT_TIMEOUT_NODE : embeds
RK_OBJ_MUTEX *-- RK_STRUCT_LIST_NODE : embeds mutexNode

' Blocking objects hold list heads containing task nodes.
RK_OBJ_MEM_PARTITION *-- RK_STRUCT_LIST : waitingQueue
RK_OBJ_SEMAPHORE *-- RK_STRUCT_LIST : waitingQueue
RK_OBJ_MUTEX *-- RK_STRUCT_LIST : waitingQueue
RK_OBJ_SLEEP_QUEUE *-- RK_STRUCT_LIST : waitingQueue
RK_OBJ_MESG_QUEUE *-- RK_STRUCT_LIST : sender / receiver queues
RK_STRUCT_TIMEOUT_NODE --> RK_STRUCT_LIST : waitingQueuePtr
RK_STRUCT_LIST_NODE ..> RK_OBJ_TCB : task node belongs to

' Synchronization ownership and task-local state.
RK_OBJ_MUTEX "0..1" --> "1" RK_OBJ_TCB : ownerPtr
RK_OBJ_TCB *-- Task_Event_Register : embeds
RK_OBJ_TCB "1" --> "0..*" RK_OBJ_MUTEX : ownedMutexList

' Message and memory relationships.
RK_OBJ_MESG_QUEUE *-- RK_STRUCT_RING_BUFFER : embeds
RK_OBJ_MESG "0..*" --> "1" RK_OBJ_MEM_PARTITION : allocated from
RK_OBJ_MESG "0..*" --> "1" RK_OBJ_TCB : sender / receiver / owner
RK_OBJ_MRM *-- RK_OBJ_MEM_PARTITION : embeds allocators
RK_OBJ_MRM "1" --> "0..*" RK_OBJ_MRM_BUF : manages buffers

' Timers use the global timeout infrastructure.
RK_OBJ_TIMER ..> RK_STRUCT_RUNTIME : scheduled against
RK_STRUCT_RUNTIME ..> RK_STRUCT_TIMEOUT_NODE : drives timeout lists
RK_OBJ_TCB ..> RK_OBJ_TIMER : sleep / wake timing

' Synchronous messaging keeps the call protocol in task control blocks.
RK_OBJ_TCB *-- RK_STRUCT_SYNCH_ATTR : call attributes
RK_OBJ_TCB *-- RK_STRUCT_SYNCH_CALL_DATA : call data
RK_OBJ_TCB ..> RK_OBJ_TCB : caller / sender / receiver relationships

' Trace APIs inspect live control blocks and emit snapshot structures.
RK0_API ..> RK_TRACE_TASK_INFO : kTrace task query
RK0_API ..> RK_TRACE_OBJECT_INFO : kTrace object query
RK0_API ..> RK_TRACE_SYNC_INFO : kTrace sync query
RK0_API ..> RK_TRACE_TIMER_INFO : kTrace timer query
RK_TRACE_TASK_INFO ..> RK_OBJ_TCB : snapshots
RK_TRACE_OBJECT_INFO ..> RK_OBJ_MESG_QUEUE : snapshots
RK_TRACE_SYNC_INFO ..> RK_OBJ_SEMAPHORE : snapshots
RK_TRACE_SYNC_INFO ..> RK_OBJ_MUTEX : snapshots
RK_TRACE_TIMER_INFO ..> RK_OBJ_TIMER : snapshots

note "Configuration switches in kconfig.h conditionally compile dynamic objects,\nsemaphores, mutexes, sleep queues, message queues, timers, async/sync messaging, and MRM." as N1
N1 .. RK0_API

@enduml
